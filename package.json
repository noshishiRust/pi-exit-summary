{
	"name": "pi-exit-summary",
	"version": "0.1.0",
	"description": "Pi extension that prints a provider-neutral token usage summary when Pi exits",
	"keywords": [
		"pi-package"
	],
	"homepage": "https://github.com/noshishiRust/pi-exit-summary#readme",
	"bugs": {
		"url": "https://github.com/noshishiRust/pi-exit-summary/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noshishiRust/pi-exit-summary.git"
	},
	"type": "module",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@12.6.0",
	"scripts": {
		"test": "node --test test/*.test.ts",
		"check": "tsc --noEmit",
		"fmt": "oxfmt src test",
		"fmt:check": "oxfmt src test --check",
		"lint": "oxlint src test"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@types/node": "^26.6.5",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"typescript": "^7.0.2"
	}
}
